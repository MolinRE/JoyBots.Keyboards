<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>JoyBots.Keyboards</AssemblyName>
        <RootNamespace>JoyBots.Keyboards</RootNamespace>
        <AssemblyVersion>0.0.3.0</AssemblyVersion>
        <FileVersion>0.0.3.0</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <LangVersion>latestmajor</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Title>JoyBots.Keyboards</Title>
        <PackageVersion>0.0.3</PackageVersion>
        <Authors>Konstantin Komarov</Authors>
        <Description>Keyboards for Telegram bots.</Description>
        <Copyright>Konstantin Komarov, 2025</Copyright>
        <PackageProjectUrl>https://github.com/MolinRE/JoyBots.Keyboards</PackageProjectUrl>
        <PackageLicense>https://github.com/MolinRE/JoyBots.Keyboards/blob/main/LICENSE</PackageLicense>
        <RepositoryUrl>https://github.com/MolinRE/JoyBots.Keyboards</RepositoryUrl>
        <RepositoryType>GitHub</RepositoryType>
        <PackageTags>telegram</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes></PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Telegram.Bot" Version="22.5.1" />
    </ItemGroup>


    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
